# ─── Production Environment Variables ────────────────────────────────────────
# Bu dosyayı kopyalayıp ".env" olarak kaydet: cp .env.example .env
# .env dosyasını asla Git'e commit etme! .gitignore'a ekli olduğundan emin ol.

# ─── Veritabanı Şifreleri ────────────────────────────────────────────────────
# Üretmek için: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_strong_user_db_password
EVENT_DB_PASSWORD=CHANGE_ME_strong_event_db_password

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Üretmek için: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_at_least_64_char_secret_key
# ms cinsinden — 3600000 = 1 saat, 86400000 = 1 gün
JWT_EXPIRATION=3600000

# ─── Admin Hesabı ────────────────────────────────────────────────────────────
ADMIN_USERNAMES=admin
ADMIN_PASSWORDS=CHANGE_ME_strong_admin_password

# ─── Eureka Basic Auth ───────────────────────────────────────────────────────
# Üretmek için: openssl rand -base64 16
EUREKA_ADMIN_USERNAME=CHANGE_ME_eureka_username
EUREKA_ADMIN_PASSWORD=CHANGE_ME_strong_eureka_password

# ─── Harici Servisler ────────────────────────────────────────────────────────
RESEND_API_KEY=re_CHANGE_ME

# ─── Kafka KRaft Cluster ID ──────────────────────────────────────────────────
# Üretmek için: openssl rand -hex 16
# ⚠️  KRaft bu değeri volume içine yazar. İlk `docker compose up`'tan ÖNCE
#    belirle. Sonradan değiştirirsen Kafka başlamaz (Inconsistent cluster ID).
#    Dev ve Prod için FARKLI değerler kullan.
KAFKA_CLUSTER_ID=CHANGE_ME_16_hex_chars

# ─── CORS ────────────────────────────────────────────────────────────────────
# Prod frontend domainin (wildcard KULLANMA)
CORS_ALLOWED_ORIGINS=https://akissy.com

# ─── GHCR (GitHub Container Registry) ───────────────────────────────────────
# GitHub kullanıcı adın (küçük harf olmalı)
GHCR_USERNAME=CHANGE_ME_github_username

# ─── Traefik Let's Encrypt ───────────────────────────────────────────────────
# ACME sertifika bildirimleri bu adrese gider
TRAEFIK_ACME_EMAIL=CHANGE_ME_your_email@example.com

