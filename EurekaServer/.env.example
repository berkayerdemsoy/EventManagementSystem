# Eureka Server - Environment Variables

# Uygulama portu
SERVER_PORT=8761

# Eureka instance hostname (Docker'da servis adı olmalı)
EUREKA_HOSTNAME=eureka-server

# Eureka Basic Auth — üretmek için: openssl rand -base64 16
EUREKA_ADMIN_USERNAME=CHANGE_ME_eureka_username
EUREKA_ADMIN_PASSWORD=CHANGE_ME_strong_eureka_password
